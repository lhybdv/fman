/*
 * Catppuccin Mocha: base #1e1e2e, mantle #181825, crust #11111b,
 * surface0 #313244, surface1 #45475a, surface2 #585b70,
 * overlay1 #7f849c, subtext1 #bac2de, subtext0 #a6adc8, text #cdd6f4,
 * mauve #cba6f7, blue #89b4fa.
 */

QTableView, QMessageBox, QDialog, QListView {
	background-color: #1e1e2e;
	border: none;
}

QHeaderView, QHeaderView::section {
	background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #313244, stop: 1 #1e1e2e);
}

QHeaderView::section {
	color: #7f849c;
	border: none;
	padding: 1ex;
	border-style: solid;
	border-left-width: 1px;
	border-left-color: #1e1e2e;
	border-right-color: #313244;
	border-right-width: 1px;
}

QTableView::item {
	color: #a6adc8;
	padding-top: 1px;
	padding-bottom: 1px;
}

/*
 * Hack: Unlike QTreeView::item, QTableView::item has no :first and :last
 * selectors. To work around this, our backend sets State_Children and
 * State_Open, which we can catch here as :has-children and :open, respectively.
 */
QTableView::item:has-children {
	color: #cdd6f4;
	padding-left: 0.25em;
	/* The padding directive has no effect unless we specify a background: */
	background: transparent;
}
QTableView::item:open {
	padding-right: 0.25em;
}

QTableView::item:selected {
	color: #cba6f7;
	/* Avoid the ugly default blue background color for selected cells: */
	background-color: #1e1e2e;
}

QTableView::item:focus {
	background-color: #313244;
}

QTableView #editor {
	/*
	 * The Qt "editor" when renaming a file. It's a QLineEdit, which has a
	 * border (see below). On Windows, this border shifts the file name down so
	 * much that underscores "_" are obscured. Prevent this:
	 */
	border-top: none;
	border-bottom: none;
}

QLabel, QRadioButton, QCheckBox {
	color: #a6adc8;
}

QMessageBox QLabel {
	font-weight: normal;
}

QLineEdit {
	color: #cdd6f4;
	background-color: #313244;
	border: 1px solid #45475a;
	border-left-color: #1e1e2e;
	border-top-color: #1e1e2e;
}

Prompt QLineEdit {
	min-width: 20em;
}

Quicksearch {
	background-color: #313244;
}

Quicksearch #query-container {
	/*
	 * The sole purpose of this Div is to draw an extra border at the bottom.
	 */
	padding: 0;
	margin: 3px;
	border: 1px solid #313244;
	border-bottom-color: #585b70;
}

Quicksearch #query-container > Div {
	padding: 0;
	border: 1px solid #1e1e2e;
}

Quicksearch QLineEdit {
	color: #cdd6f4;
	background-color: #1e1e2e;
	border: 1px solid #45475a;
	border-top-color: #585b70;
	border-left-color: #45475a;
	border-right-color: #45475a;
}

Quicksearch #items-container {
	margin-bottom: 4px;
}

Quicksearch QListView {
	min-width: 40em;
	background-color: #313244;
	margin-left: 4px;
	margin-right: 4px;
}

Quicksearch QListView::item:selected {
	background-color: #45475a;
}

QLineEdit:read-only {
	color: #9399b2;
}

QStatusBar {
	background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #313244, stop: 1 #181825);
	border-top: 1px solid #45475a;
}

QStatusBar, QStatusBar QLabel {
	color: #cdd6f4;
}

QStatusBar QLabel {
	padding-left: .1ex;
}

Overlay {
	min-width: 20em;
	max-width: 22em;
	background-color: #1e1e2e;
	border: 1px solid #45475a;
}

Overlay QPushButton {
	max-width: 10em;
}

FilterBar {
	background-color: #1e1e2e;
	border: 1px solid #45475a;
	min-width: 8em;
}

FilterBar QLineEdit {
	font-size: 10pt;
	width: 7em;
	margin: 0 .25em;
}

NonexistentShortcutDialog {
	min-width: 15em;
}

NonexistentShortcutDialog QRadioButton {
	margin-left: 1em;
}

NonexistentShortcutDialog QLineEdit {
	margin-left: 2.25em;
	margin-right: 1em;
}

QRadioButton::checked {
	color: #cdd6f4;
}

ProgressDialog {
	min-width: 25em;
	/*
	 * Make max-width at least a little wider than min-width.
	 * Otherwise, there sometimes seem to be visual artifacts.
	 */
	max-width: 30em;
}
