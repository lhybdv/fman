QMenu {
	font-family: "Helvetica Neue";
	color: #cdd6f4;
	font-size: 14pt;
	background-color: #1e1e2e;
	padding-top: .75ex;
	padding-bottom: .75ex;
	/* border-radius is set in the `Menu` class in fman */
}

QMenu::item {
	background-color: #1e1e2e;
	padding: .35ex 1.5ex .3ex 3ex;
	min-width: 25ex;
}

QMenu::item:selected {
	background-color: #45475a;
	color: #cdd6f4;
}

QMenu::separator {
	height: 2px;
	background: #313244;
	margin: .75ex 0;
}

FilterBar QLineEdit {
	font-size: 12pt;
}